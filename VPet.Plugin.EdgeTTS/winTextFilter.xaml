<Window x:Class="VPet.Plugin.VPetTTS.winTextFilter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VPet.Plugin.VPetTTS"
        mc:Ignorable="d" xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI" Title="{ll:Str 括号过滤设置}"
        Width="450" FontSize="16" Height="Auto" ResizeMode="NoResize" WindowState="Normal" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PrimaryLighter}">
    <Window.Resources>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
    </Window.Resources>
    <StackPanel Margin="8" Background="{DynamicResource PrimaryLighter}">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="14"
                Text="{ll:Str 勾选的括号，其内部内容不会被朗读。气泡里依然显示原文，所以动作描写看得到、听不到。}" />

        <Border BorderBrush="{DynamicResource DARKPrimaryDark}" BorderThickness="1" CornerRadius="4"
                Margin="0,0,0,8" Padding="8">
            <StackPanel>
                <CheckBox x:Name="FilterRound" Margin="0,3" Content="{ll:Str 圆括号　( )　（ ）}" />
                <CheckBox x:Name="FilterSquare" Margin="0,3" Content="{ll:Str 方括号　[ ]　【 】　〔 〕}" />
                <!--半角花括号在 XAML 标记扩展里是保留字符，文案改用全角回避转义-->
                <CheckBox x:Name="FilterCurly" Margin="0,3" Content="{ll:Str 花括号　｛ ｝　半角同样生效}" />
                <CheckBox x:Name="FilterAngle" Margin="0,3" Content="{ll:Str 尖括号　&lt; &gt;　＜ ＞}"
                        ToolTip="{ll:Str 默认关闭：大于小于号会被误伤}" />
                <CheckBox x:Name="FilterBookTitle" Margin="0,3" Content="{ll:Str 书名号　《 》　〈 〉}"
                        ToolTip="{ll:Str 默认关闭：开了之后《活着》这类书名也会被跳过}" />
                <CheckBox x:Name="FilterPairedTag" Margin="0,3" Content="{ll:Str 成对标签　&lt;动作&gt;摸摸头&lt;/动作&gt;}"
                        ToolTip="{ll:Str 连标签带里面的内容一起跳过；首尾同名才算，所以普通的大于小于号不会被误伤}" />
                <CheckBox x:Name="FilterAsterisk" Margin="0,3" Content="{ll:Str 成对星号　*动作*　**动作**}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{ll:Str 自定义括号对（开闭两个字符一组，可用空格分隔）}" FontSize="14" Margin="0,0,0,3" />
        <TextBox x:Name="FilterCustomPairs" Margin="0,0,0,8" Padding="5,3" VerticalContentAlignment="Center"
                ToolTip="{ll:Str 例如：「」『』}" />

        <TextBlock Text="{ll:Str 自定义正则（每行一条，命中的内容不朗读）}" FontSize="14" Margin="0,0,0,3" />
        <TextBox x:Name="FilterCustomRegex" Margin="0,0,0,3" Padding="5,3" FontSize="14" FontFamily="Consolas"
                TextWrapping="NoWrap" AcceptsReturn="True" Height="60"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                ToolTip="{ll:Str 每行一条正则；以井号开头的行当注释；写错的那条只会被跳过，不影响其他规则}" />
        <TextBlock x:Name="RegexError" TextWrapping="Wrap" Margin="0,0,0,8"
                Foreground="#FFD44444" FontSize="12" Visibility="Collapsed" />

        <TextBlock Text="{ll:Str 效果预览}" FontSize="14" Margin="0,0,0,3" />
        <TextBox x:Name="PreviewInput" Margin="0,0,0,5" Padding="5,3" FontSize="14"
                TextWrapping="Wrap" AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto" />
        <Border BorderBrush="{DynamicResource DARKPrimaryDark}" BorderThickness="1" CornerRadius="4"
                Margin="0,0,0,8" Padding="8" MinHeight="40">
            <TextBlock x:Name="PreviewOutput" TextWrapping="Wrap" FontSize="14"
                    Foreground="{DynamicResource DARKPrimaryDarker}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="Confirm" Grid.Column="0" pu:ButtonHelper.CornerRadius="4" Content="{ll:Str 确定}"
                    Background="{DynamicResource SecondaryLight}" BorderBrush="{DynamicResource SecondaryDark}"
                    BorderThickness="2" Margin="5,5,5,5" Click="Confirm_Click" />
            <Button x:Name="Cancel" Grid.Column="1" pu:ButtonHelper.CornerRadius="4" Content="{ll:Str 取消}"
                    Background="{DynamicResource SecondaryLight}" BorderBrush="{DynamicResource SecondaryDark}"
                    BorderThickness="2" Margin="5,5,5,5" Click="Cancel_Click" />
        </Grid>
    </StackPanel>
</Window>
